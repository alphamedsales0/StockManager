<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /stockmanager/

  # ✅ Ne pas toucher à /api/ (sinon tout est réécrit vers index.html)
  RewriteRule ^api/ - [L]

  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /stockmanager/index.html [L]
</IfModule>